{
  "compilerOptions": {
    "lib": ["ES2024", "DOM"],
    "baseUrl": ".",
    "paths": {
      "obsidian": ["node_modules/obsidian"]
    },
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "es2020",
    "allowJs": false,
    "noImplicitAny": true,
    "strictFunctionTypes": true,
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "moduleResolution": "Bundler",
    "importHelpers": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["main.ts", "sync_queue.ts", "sync_queue.test.ts"]
}
